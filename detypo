#!/usr/bin/env bash
# =============================================================================
# detypo — Detypo PDF Proofreader one-click launcher
# =============================================================================
# Usage:
#   ./detypo              Prod mode (build, serve at auto-detected port)
#   ./detypo dev           Dev mode (hot-reload, opens :5173)
#   ./detypo stop          Stop all services
#
# Port: auto-detected (scans upward from 8520). The actual port is shown
# in the banner and written to .detypo-port.
#
# Requires: Python 3.10+
# Node.js 18+ is only needed for dev mode or source checkouts without frontend/dist.
# =============================================================================

set -e

# ── CD to script directory ──
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

PORT_FILE="$SCRIPT_DIR/.detypo-port"
PID_DIR="${TMPDIR:-/tmp}/detypo-pids"
FRONTEND_DIR="frontend"
mkdir -p "$PID_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}[detypo]${NC} $1"; }
ok()    { echo -e "${GREEN}[detypo]${NC} $1"; }
warn()  { echo -e "${YELLOW}[detypo]${NC} $1"; }
err()   { echo -e "${RED}[detypo]${NC} $1"; }

# ── Find Python ──
PYTHON=""
for c in python python3; do
    if command -v "$c" &>/dev/null && "$c" --version &>/dev/null 2>&1; then
        PYTHON="$c"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    err "Python not found. Please install Python 3.10+"
    exit 1
fi

# ── Find an available port (prefer last-used, scan range, fallback to OS-assigned) ──
find_port() {
    local start=${1:-8520} count=${2:-50} preferred=${3:-0}
    $PYTHON -c "
import socket
preferred = $preferred
if preferred:
    try:
        s = socket.socket()
        s.bind(('127.0.0.1', preferred))
        s.close()
        print(preferred)
        exit()
    except OSError:
        pass
for p in range($start, $start + $count):
    try:
        s = socket.socket()
        s.bind(('127.0.0.1', p))
        s.close()
        print(p)
        break
    except OSError:
        continue
else:
    s = socket.socket()
    s.bind(('127.0.0.1', 0))
    print(s.getsockname()[1])
    s.close()
"
}

# ── Detect ports: reuse last port if still available ──
PREFERRED_PORT=$(cat "$PORT_FILE" 2>/dev/null || echo 0)
BACKEND_PORT=$(find_port 8520 50 "$PREFERRED_PORT")
FRONTEND_PORT=$(find_port 5173 10 0)

# ── Kill port (Windows + Unix) ──
kill_port() {
    local port=$1 pid
    # Windows
    local pids
    pids=$(netstat -ano 2>/dev/null | grep ":${port} " | grep "LISTENING" | awk '{print $NF}' | sort -u)
    for pid in $pids; do
        [ -z "$pid" ] && continue
        [ "$pid" = "0" ] && continue
        taskkill //PID "$pid" //F //T >/dev/null 2>&1 || true
    done
    # Unix
    if command -v lsof &>/dev/null; then
        pid=$(lsof -ti :"${port}" 2>/dev/null)
        [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
    fi
    sleep 0.3
}

# ── Wait for service ──
wait_for() {
    local url=$1 name=$2 max=${3:-30} i=0 code
    info "Waiting for ${name}..."
    while [ $i -lt $max ]; do
        code=$(curl -s -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo "000")
        if [ "$code" != "000" ]; then
            ok "${name} ready"
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    warn "${name} may not be ready (timeout)"
    return 1
}

# ── Open browser ──
open_browser() {
    info "Opening browser: $1"
    powershell -Command "Start-Process '$1'" 2>/dev/null || xdg-open "$1" 2>/dev/null || open "$1" 2>/dev/null || true
}

# ── Install deps if needed ──
ensure_deps() {
    if ! "$PYTHON" -c "import fastapi, uvicorn, pymupdf, requests, pydantic" 2>/dev/null; then
        info "Installing Python dependencies..."
        pip install -r requirements.txt >/dev/null 2>&1 || {
            err "Python dep install failed. Check network."
            exit 1
        }
        ok "Python deps ready"
    fi
}

ensure_node() {
    if ! command -v node &>/dev/null; then
        err "Node.js not found. Please install Node.js 18+ or download a prebuilt Detypo release."
        exit 1
    fi
}

ensure_frontend_deps() {
    ensure_node
    if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
        info "Installing frontend dependencies..."
        (cd "$FRONTEND_DIR" && npm install --silent) || {
            err "Frontend dep install failed. Check network."
            exit 1
        }
        ok "Frontend deps ready"
    fi
}

# ── Cleanup ──
cleanup() {
    # Read port file if it exists
    if [ -f "$PORT_FILE" ]; then
        local saved_port
        saved_port=$(cat "$PORT_FILE" 2>/dev/null || true)
        if [ -n "$saved_port" ]; then
            kill_port "$saved_port"
        fi
        rm -f "$PORT_FILE"
    fi
    # Fallback: kill on default ports
    kill_port 8520
    kill_port 5173
    # Clean PID files
    rm -f "$PID_DIR"/*.pid
}

# ── stop ──
do_stop() {
    info "Stopping services..."
    cleanup
    ok "Stopped"
}

# ── Prod mode ──
do_prod() {
    info "Detypo - Prod Mode"
    ensure_deps

    if [ -f "$FRONTEND_DIR/dist/index.html" ]; then
        ok "Using prebuilt frontend"
    else
        ensure_frontend_deps
        info "Building frontend..."
        (cd "$FRONTEND_DIR" && npm run build) || { err "Frontend build failed"; exit 1; }
        ok "Frontend build done"
    fi

    echo ""
    echo -e "${GREEN}======================================${NC}"
    echo -e "${GREEN}  Detypo is running (prod)${NC}"
    echo -e "${GREEN}  URL:  http://127.0.0.1:${BACKEND_PORT}${NC}"
    echo -e "${GREEN}  Stop: Ctrl+C or close this window${NC}"
    echo -e "${GREEN}======================================${NC}"
    echo ""
    open_browser "http://127.0.0.1:${BACKEND_PORT}"

    export DETYPO_PROD=1
    "$PYTHON" server.py --port "$BACKEND_PORT"
    echo ""
    info "Server stopped. Cleaning up..."
    cleanup
    ok "Done"
}

# ── Dev mode ──
do_dev() {
    info "Detypo - Dev Mode"
    ensure_deps
    ensure_frontend_deps

    info "Starting backend (127.0.0.1:${BACKEND_PORT})..."
    "$PYTHON" server.py --port "$BACKEND_PORT" > /tmp/detypo-backend.log 2>&1 &
    echo $! > "$PID_DIR/backend.pid"
    wait_for "http://127.0.0.1:${BACKEND_PORT}" "Backend" 20

    info "Starting frontend (127.0.0.1:${FRONTEND_PORT})..."
    (cd "$FRONTEND_DIR" && npm run dev -- --port "$FRONTEND_PORT" > /tmp/detypo-frontend.log 2>&1) &
    echo $! > "$PID_DIR/frontend.pid"
    wait_for "http://127.0.0.1:${FRONTEND_PORT}" "Frontend" 20

    echo ""
    echo -e "${GREEN}======================================${NC}"
    echo -e "${GREEN}  Detypo is running (dev)${NC}"
    echo -e "${GREEN}  URL:  http://127.0.0.1:${FRONTEND_PORT}${NC}"
    echo -e "${GREEN}  Stop: ./detypo stop${NC}"
    echo -e "${GREEN}======================================${NC}"
    echo ""
    open_browser "http://127.0.0.1:${FRONTEND_PORT}"
}

# ── Entry ──
case "${1:-prod}" in
    dev)  do_dev ;;
    prod) do_prod ;;
    stop) do_stop ;;
    *)
        echo "Usage: ./detypo {prod|dev|stop}"
        echo "  prod  Prod mode (default) — build and serve at auto-detected port"
        echo "  dev   Dev mode — hot-reload, opens :5173"
        echo "  stop  Stop all services"
        exit 1
        ;;
esac
